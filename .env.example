# Copy to .env and fill in. Never commit .env.
TICKETMASTER_API_KEY=
SKIDDLE_API_KEY=
TMDB_API_KEY=
ANTHROPIC_API_KEY=

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Where `events-agent status` sends the admin stats/cost email. Optional —
# falls back to SMTP_USER (the sending account) if left blank.
ADMIN_EMAIL=
